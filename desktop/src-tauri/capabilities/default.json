{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions de la fenêtre principale (le strict nécessaire)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "core:window:allow-hide",
    "core:window:allow-destroy",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/helpva-engine", "sidecar": true, "args": false }]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "dialog:allow-open",
    "opener:default",
    "notification:default"
  ]
}
